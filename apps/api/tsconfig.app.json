{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": ["node"],
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../libs/domain/social/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domain/coach-ia/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domain/profile/tsconfig.lib.json"
    },
    {
      "path": "../../libs/domain/auth/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/database/tsconfig.lib.json"
    }
  ]
}
